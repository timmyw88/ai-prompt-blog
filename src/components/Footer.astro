---
import { site, socialLinks } from '../lib/site';
import { pageHref, withBase } from '../lib/urls';

const social = socialLinks();
---

<footer class="site-footer">
  <div class="wrap">
    <p>
      {site.title} is a static archive. There is no sign-in. You edit the files on GitHub, and the public site is
      rebuilt from those files.
    </p>
    <p>
      If the repository is public, every committed file is public. That includes draft tutorials and pictures. Do not
      commit passwords, API keys, or private photos.
    </p>
    <nav aria-label="Footer">
      <ul class="nav-list">
        <li><a href={pageHref('')}>Archive</a></li>
        <li><a href={pageHref('guide')}>Editing guide</a></li>
        <li><a href={pageHref('about')}>About</a></li>
        <li><a href={pageHref('privacy')}>Privacy</a></li>
        <li><a href={withBase('rss.xml')}>RSS</a></li>
      </ul>
    </nav>
    {
      social.length > 0 && (
        <ul class="social-list">
          {social.map((link) => (
            <li>
              <a href={link.href} rel="me">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
