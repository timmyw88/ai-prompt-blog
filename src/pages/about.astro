---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base title="About" description={`About ${site.title}.`}>
  <h1>About</h1>
  <div class="prose">
    <p>
      {site.title} is a public archive of image and video workflows. Each tutorial keeps the prompt, the settings,
      and the numbered steps in one place.
    </p>
    <p>Viewers can search the archive and copy a prompt. There is no account and no sign-in.</p>
  </div>
</Base>
